# ─────────────────────────────────────────────────────────────
# STAGING values for /var/www/stage.antisocialtalks.com/.env.local
#
# Create this file ON THE VPS. Do NOT upload your local .env.local —
# that one points at localhost and would silently break the deploy.
#
# NEXT_PUBLIC_* values are baked into the bundle at build time, so this
# file must exist BEFORE you run `npm run build`.
# ─────────────────────────────────────────────────────────────

# ---- Site ----
# Anything that is not antisocialtalks.com is treated as staging by the app:
# robots.txt disallows everything and every page sends a meta noindex.
NEXT_PUBLIC_SITE_URL=https://stage.antisocialtalks.com
# Search engines: true ONLY on the live site. Anything else (staging, local)
# is Disallow: / in robots.txt and noindex on every page.
SITE_INDEXABLE=false

# ---- Directus CMS ----
# Next and Directus are on the same box, so go straight to the container and
# skip nginx, TLS and Cloudflare for every content read.
DIRECTUS_URL=http://127.0.0.1:8055
NEXT_PUBLIC_DIRECTUS_URL=https://cms-stage.antisocialtalks.com
# Static token of a READ-ONLY Directus user (not the admin).
# Directus -> User Directory -> the user -> Token -> Generate -> Save user.
# With this set, no collection needs to be made public.
DIRECTUS_TOKEN=

# ---- Gelato ----
# Safe to use the real key on staging: with Stripe test keys (sk_test_)
# a paid order only creates a Gelato draft, which is never printed.
GELATO_API_KEY=
# The fallback currency only: each market (India, US, UK, UAE) has its own
# prices and is charged in its own currency through Stripe.
NEXT_PUBLIC_SHOP_CURRENCY=INR
# false = "Coming Soon" shop (no cart or checkout). Leave true on staging.
NEXT_PUBLIC_SHOP_OPEN=true

# ---- Email (confirmations + team notifications) ----
# Microsoft 365 (Outlook) through Microsoft Graph. Needs an Entra app
# registration with the Mail.Send application permission (admin consent).
# Leave blank and everything still saves to the CMS; only emails are skipped.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_FROM="AntiSocialTalks <admin@antisocialtalks.com>"
# Or an SMTP mailbox (leave MS_* blank). 465 = TLS, 587 = STARTTLS. MAIL_FROM
# should then be that mailbox. Write any "$" in the password as "\$".
# Check from the server with: node scripts/verify/verify-mail.mjs
SMTP_HOST=
SMTP_PORT=465
# Optional: true/false to force TLS on or off (otherwise 465 = TLS, 587 = STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Or use Resend instead of Microsoft (leave MS_* blank):
RESEND_API_KEY=
# Inbox that gets a copy of every registration, application and paid order.
TEAM_NOTIFY_EMAIL=admin@antisocialtalks.com

# ---- Payments (Stripe: shop orders + paid event tickets) ----
# The selling company is in Canada, so payments go through Stripe.
# none = checkout and paid bookings stay closed. stripe = live.
# Use sk_test_ keys on staging; nothing real is charged or printed.
PAYMENT_GATEWAY=none
STRIPE_SECRET_KEY=
# Developers -> Webhooks -> endpoint https://<site>/api/webhooks/payment,
# events checkout.session.completed + checkout.session.async_payment_succeeded:
STRIPE_WEBHOOK_SECRET=

# ---- India printing (Qikink) ----
# Dashboard -> Integration -> Custom API. Orders delivered in India go here.
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
# https://sandbox.qikink.com to test (staging); leave empty for real orders.
QIKINK_BASE_URL=

# ---- Order jobs (shipping emails, refunds, unfinished checkouts) ----
# Any long random string; the server crontab sends it to /api/cron/orders.
# Make one with: openssl rand -hex 32
CRON_SECRET=
