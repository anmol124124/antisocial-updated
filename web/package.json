{
  "name": "antisocialtalks-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3012",
    "build": "next build",
    "start": "next start -p 3012",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/support/register.mjs --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "verify:gelato": "node scripts/verify/verify-gelato.mjs",
    "verify:stripe": "node scripts/verify/verify-stripe.mjs",
    "verify:mail": "node scripts/verify/verify-mail.mjs",
    "verify:shop": "node scripts/verify/verify-shop.mjs",
    "setup:local": "node scripts/dev/setup-local.mjs",
    "cms:provision": "node ../cms/scripts/provision.mjs",
    "cms:token": "node ../cms/scripts/create-site-token.mjs",
    "cms:up": "docker compose -f ../cms/docker-compose.local.yml up -d",
    "cms:logs": "docker compose -f ../cms/docker-compose.local.yml logs -f directus",
    "cms:down": "docker compose -f ../cms/docker-compose.local.yml down"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "2.16.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
