# nginx for cms-stage.antisocialtalks.com -> Directus on 127.0.0.1:8055.
#
#   sudo cp cms-stage.antisocialtalks.com.nginx /etc/nginx/sites-available/cms-stage.antisocialtalks.com
#   sudo ln -s /etc/nginx/sites-available/cms-stage.antisocialtalks.com /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name cms-stage.antisocialtalks.com;

    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        proxy_pass http://127.0.0.1:8055;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50M;
    }
}
