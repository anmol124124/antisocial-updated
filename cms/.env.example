# Copy this to .env on the VPS (never upload the real .env from Windows —
# same rule as the backend project) and fill in every value below.

# Generate these two with: openssl rand -hex 32
DIRECTUS_KEY=
DIRECTUS_SECRET=

# Which environment this instance is. Staging and production use the SAME
# docker-compose.yml and differ only here.
#
#   staging:     PUBLIC_URL=https://cms-stage.antisocialtalks.com
#                CORS_ORIGIN="https://stage.antisocialtalks.com"
#   production:  PUBLIC_URL=https://cms.antisocialtalks.com
#                CORS_ORIGIN="https://antisocialtalks.com,https://www.antisocialtalks.com"
PUBLIC_URL=https://cms-stage.antisocialtalks.com
CORS_ORIGIN="https://stage.antisocialtalks.com"

# Pick a strong password for the Postgres database user.
DB_PASSWORD=

# First superadmin login for the Directus dashboard at
# https://cms.antisocialtalks.com — change ADMIN_PASSWORD to something
# strong; you can create more team logins inside Directus afterwards.
ADMIN_EMAIL=gurpreet@kapoorwealth.com
ADMIN_PASSWORD=

# Outbound email, used only by the "new submission" notification Flow.
# Leave all four SMTP_* blank to launch without email notifications —
# submissions still land safely in the Directus dashboard either way.
EMAIL_FROM=noreply@antisocialtalks.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
