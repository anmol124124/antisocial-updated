# ---- Server ----
PORT=3011
# Comma-separated list of origins allowed to call this API from the browser
CORS_ORIGIN=https://antisocialtalks.com,https://www.antisocialtalks.com

# ---- Gelato (required) ----
# From https://dashboard.gelato.com -> Store -> API keys
GELATO_API_KEY=your-gelato-api-key
# Optional: only needed if you use the Ecommerce (connected store) endpoints
GELATO_STORE_ID=

# Shared secret Gelato signs webhook payloads with, if/when you configure
# a webhook subscription in the Gelato dashboard. Leave blank until then.
GELATO_WEBHOOK_SECRET=

# ---- Payment gateway (NOT configured yet) ----
# Fill these in once a gateway is chosen (Stripe / Razorpay / both).
# See src/paymentGateway.js for where they get wired in.
PAYMENT_GATEWAY=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
